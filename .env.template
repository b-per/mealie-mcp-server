# Mealie API Configuration
# Replace these values with your own Mealie instance details

# The base URL of your Mealie instance (including protocol and port if needed)
MEALIE_BASE_URL=https://your-mealie-instance.com

# Your Mealie API key
# Generate this from your Mealie account settings
MEALIE_API_KEY=your-mealie-api-key

# MCP transport. Keep stdio for local desktop clients. Use streamable-http for
# remote clients, then connect them to http://HOST:PORT/MCP_HTTP_PATH.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_HTTP_PATH=/mcp
MCP_STATELESS_HTTP=false
MCP_JSON_RESPONSE=false

LOG_LEVEL=INFO
